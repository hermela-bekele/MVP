# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI response cache
.cache/

# Training videos (large files - download separately or use CDN)
public/videos/training/**/*.mp4
public/videos/training/**/*.webm
public/videos/training/**/*.mov
# Keep folder structure
!public/videos/training/**/.gitkeep

# Uploaded resource files (stored on API server)
backend/uploads/*
!backend/uploads/.gitkeep
